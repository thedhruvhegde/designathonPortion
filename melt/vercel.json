{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    { "source": "/", "destination": "/web/", "permanent": false },
    { "source": "/live", "destination": "/web/#/live", "permanent": false },
    { "source": "/join", "destination": "/web/#/join", "permanent": false }
  ],
  "headers": [{ "source": "/api/(.*)", "headers": [{ "key": "Cache-Control", "value": "no-store" }] }]
}
